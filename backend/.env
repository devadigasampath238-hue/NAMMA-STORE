# Copy to backend/.env or export these before running the backend.
# NOTHING sensitive is committed: application.properties only reads these.

DB_URL=jdbc:postgresql://localhost:5432/namma_store_dev
DB_USERNAME=postgres
DB_PASSWORD=Sampath@123

APP_PUBLIC_BASE_URL=http://localhost:8080
APP_CORS_ORIGIN=http://localhost:3000

APP_DELIVERY_CHARGE=49
APP_FREE_DELIVERY_ABOVE=499

# Leave blank for local disk storage (./uploads)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_LOCAL_DIR=uploads

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Firebase Admin SDK (REQUIRED for admin access) ----
# Firebase console > Project settings > Service accounts > Generate new
# private key. Save the JSON OUTSIDE the repo and point at it here.
# Without this the backend cannot verify ID tokens and every
# /api/admin/** call returns 401.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json

# LOCAL DEVELOPMENT ESCAPE HATCH - leave false.
# When true, and only when Firebase Admin failed to initialise, the API
# trusts whatever UID the client sends. That is the old, broken behaviour
# and it hands anyone full admin. Never set this anywhere reachable from
# the internet.
APP_AUTH_ALLOW_INSECURE_UID_FALLBACK=false

# Delivery bands (rupees)
APP_SMALL_ORDER_THRESHOLD=200
APP_SMALL_ORDER_CHARGE=40
