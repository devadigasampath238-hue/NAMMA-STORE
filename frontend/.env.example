# Copy this file to .env.local and fill in your own values.
# The real .env.local is intentionally NOT shipped in this zip.
#
# Firebase web config is public by design (it ships in the browser bundle),
# but it identifies YOUR project, so it is left as placeholders here.

NEXT_PUBLIC_API_URL=http://localhost:8080

# Firebase (from Firebase console > Project settings > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Razorpay: no frontend key is required yet (payments are simulated).
